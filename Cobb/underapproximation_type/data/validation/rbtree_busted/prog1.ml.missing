let[@assert] missing_ty =
  let inv = (v >= 0 : [%v: int]) [@over] in
  let color = (true : [%v: bool]) [@over] in
  let[@assert] h =
    (v >= 0 && if color then v + v == inv else v + v + 1 == inv
      : [%v: int])
      [@over]
  in
  (((h == 0 && (num_black v 0) && not (rb_root_color v true) && color)) && num_black v h && no_red_red v && (color #==> (not (rb_root_color v true))) && ((not color) #==> ((h == 0) #==> (not (rb_root_color v false))))
    : [%v: int rbtree])
    [@under]
