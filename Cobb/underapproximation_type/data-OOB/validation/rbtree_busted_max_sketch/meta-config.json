{
    "mode": "debug",
    "max_printing_size": 300,
    "debug_tags": [
        // "preprocess",
        // "ntyping",
        // "typing",
        // "queries",
        "result",
        "never-use"
    ],
    "logfile": ".log",
    "resfile": ".result",
    "abdfile": ".abd",
    "synfile": ".syn",
    "collectfile": ".collect",
    "abd_templates": [
        // "template_rb_leaf",
        "template_eq_0",
        "template_num_black_0",
        "template_black_root",
        "template_red_root"
    ],
    "num_quantifier": 0,
    "abduce_rlimit":4000000,
    "synth_bound": 100,
    "synth_rlimit": 50000,
    "synth_timeout": 1000, // Sadly Z3 doesn't always respect the rlimit
    "type_rlimit": 70000000,
    "use_missing_coverage_file": false,
    "comp_path": "components.txt",
    "prim_path": {
        "data_type_decls": "data/predefined/data_type_decls.ml",
        "templates": "data/predefined/templates.ml",
        "normal_typing": "data/predefined/normal_typing.ml",
        "axioms": "data/validation/rbtree_busted_max_sketch/axioms.ml",
        "coverage_typing": "data/predefined/coverage_typing.ml"
    }
}
